{
  "version": 6,
  "configurePresets": [
    {
      "name": "mingw",
      "displayName": "Windows x64 from macOS / Linux (mingw-w64 cross compiler)",
      "binaryDir": "${sourceDir}/build/mingw",
      "toolchainFile": "${sourceDir}/cmake/mingw-x64.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows",
      "displayName": "Windows x64 (MSYS2 MINGW64 shell)",
      "binaryDir": "${sourceDir}/build/windows",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "mingw", "configurePreset": "mingw" },
    { "name": "windows", "configurePreset": "windows" }
  ]
}
